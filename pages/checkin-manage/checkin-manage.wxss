.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 24rpx 160rpx;
}

.tip {
    font-size: 24rpx;
    color: #646a73;
    line-height: 1.6;
    padding: 0 8rpx 24rpx;
}

.item-list {
    padding: 4rpx 24rpx;
}

.item-row {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 2rpx solid #f0f1f2;
}

.item-row:last-child {
    border-bottom: none;
}

.item-icon {
    width: 72rpx;
    height: 72rpx;
    border-radius: 16rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36rpx;
    margin-right: 20rpx;
}

.item-info {
    flex: 1;
}

.item-name {
    font-size: 28rpx;
}

.item-fields {
    display: block;
    margin-top: 6rpx;
    font-size: 20rpx;
    color: #8a9099;
}

.action-edit,
.action-delete {
    font-size: 24rpx;
    margin-left: 24rpx;
}

.action-edit {
    color: #1769e0;
}

.action-delete {
    color: #e8615b;
}

.add-btn {
    position: fixed;
    left: 24rpx;
    right: 24rpx;
    bottom: 40rpx;
    background: #1769e0;
    color: #ffffff;
    text-align: center;
    padding: 24rpx 0;
    border-radius: 16rpx;
    font-size: 30rpx;
}

.mask {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 10;
}

.sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: #ffffff;
    border-radius: 24rpx 24rpx 0 0;
    padding: 32rpx;
    z-index: 11;
    box-sizing: border-box;
    max-height: 80vh;
    overflow-y: auto;
}

.sheet-title {
    font-size: 32rpx;
    font-weight: 500;
    margin-bottom: 24rpx;
}

.form-row {
    display: flex;
    align-items: center;
    min-height: 90rpx;
    border-bottom: 2rpx solid #f0f1f2;
}

.form-label {
    width: 160rpx;
    font-size: 26rpx;
    flex-shrink: 0;
}

.form-input {
    flex: 1;
    font-size: 26rpx;
}

.form-block {
    padding: 20rpx 0;
}

.form-block .form-label {
    display: block;
    margin-bottom: 14rpx;
}

.icon-picker {
    display: flex;
    flex-wrap: wrap;
}

.icon-option {
    width: 72rpx;
    height: 72rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36rpx;
    margin: 0 16rpx 16rpx 0;
    border: 4rpx solid transparent;
    border-radius: 12rpx;
    box-sizing: border-box;
}

.icon-option-active {
    border-color: #1769e0;
    background: #eaf2ff;
}

.color-picker {
    display: flex;
    flex-wrap: wrap;
}

.color-option {
    width: 56rpx;
    height: 56rpx;
    border-radius: 50%;
    margin: 0 20rpx 16rpx 0;
    border: 4rpx solid transparent;
    box-sizing: border-box;
}

.color-option-active {
    border-color: #1f2329;
}

.confirm-mask {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 20;
}

.confirm-dialog {
    position: fixed;
    left: 60rpx;
    right: 60rpx;
    top: 40%;
    transform: translateY(-50%);
    background: #ffffff;
    border-radius: 20rpx;
    padding: 36rpx 32rpx 24rpx;
    z-index: 21;
    box-sizing: border-box;
}

.confirm-title {
    font-size: 32rpx;
    font-weight: 600;
    text-align: center;
}

.confirm-content {
    margin-top: 20rpx;
    font-size: 26rpx;
    color: #646a73;
    line-height: 1.6;
}

.confirm-actions {
    display: flex;
    margin-top: 32rpx;
}

.confirm-btn {
    flex: 1;
    text-align: center;
    padding: 20rpx 0;
    font-size: 28rpx;
    border-radius: 12rpx;
}

.confirm-cancel {
    background: #f2f4f7;
    color: #646a73;
    margin-right: 16rpx;
}

.confirm-ok {
    background: #e8615b;
    color: #ffffff;
}

.custom-row {
    display: flex;
    align-items: center;
    margin-bottom: 12rpx;
}

.custom-input {
    flex: 1;
    font-size: 26rpx;
    border-bottom: 2rpx solid #e5e8eb;
    padding: 10rpx 0;
}

.custom-del {
    width: 56rpx;
    text-align: center;
    font-size: 34rpx;
    color: #e8615b;
}

.custom-add {
    display: inline-block;
    font-size: 24rpx;
    color: #1769e0;
    padding: 8rpx 0;
}

.custom-tip {
    display: block;
    margin-top: 8rpx;
    font-size: 20rpx;
    color: #a0a5ad;
}

.sheet-save {
    background: #1769e0;
    color: #ffffff;
    font-size: 30rpx;
    margin-top: 16rpx;
}

.sheet-save::after {
    border: none;
}

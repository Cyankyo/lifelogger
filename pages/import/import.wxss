.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 24rpx 60rpx;
}

.section {
    padding: 28rpx;
    margin-bottom: 24rpx;
}

.section-head {
    font-size: 30rpx;
    font-weight: 500;
    margin-bottom: 12rpx;
}

.section-desc {
    display: block;
    font-size: 22rpx;
    color: #8a9099;
    line-height: 1.6;
    margin-bottom: 20rpx;
}

.btn-row {
    display: flex;
    gap: 16rpx;
    margin-bottom: 20rpx;
}

.pick-btn {
    flex: 1;
    background: #eaf2ff;
    color: #1769e0;
    font-size: 28rpx;
    margin: 0;
}

.pick-btn::after {
    border: none;
}

.pick-ghost {
    background: #e8f7f1;
    color: #3eae8c;
}

.content-box {
    width: 100%;
    box-sizing: border-box;
    min-height: 200rpx;
    padding: 20rpx;
    background: #f5f7fa;
    border-radius: 12rpx;
    font-size: 24rpx;
    color: #1f2329;
    line-height: 1.5;
}

.content-tools {
    display: flex;
    justify-content: flex-end;
    margin: 12rpx 0;
}

.clear-btn {
    font-size: 24rpx;
    color: #8a9099;
}

.primary-btn {
    width: 100%;
    margin-top: 20rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 30rpx;
}

.primary-btn::after {
    border: none;
}

.summary-row {
    display: flex;
    flex-wrap: wrap;
    gap: 24rpx;
    padding: 16rpx 0 20rpx;
}

.summary-item {
    font-size: 24rpx;
    color: #646a73;
}

.summary-add {
    color: #3eae8c;
    font-weight: 500;
}

.tip-warn {
    font-size: 22rpx;
    color: #e89a3b;
    margin-bottom: 12rpx;
}

.list-card {
    background: #f5f7fa;
    border-radius: 12rpx;
    padding: 4rpx 20rpx;
}

.preview-item {
    display: flex;
    padding: 18rpx 0;
    border-bottom: 2rpx solid #ebedf0;
}

.preview-item:last-child {
    border-bottom: none;
}

.preview-date {
    width: 220rpx;
    font-size: 22rpx;
    color: #8a9099;
}

.preview-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.preview-title {
    font-size: 26rpx;
}

.preview-meta {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #8a9099;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.result-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48rpx 28rpx;
}

.result-icon {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: #e8f7f1;
    color: #3eae8c;
    font-size: 52rpx;
    text-align: center;
    line-height: 96rpx;
}

.result-title {
    margin-top: 20rpx;
    font-size: 32rpx;
    font-weight: 500;
}

.result-desc {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #8a9099;
}

.confirm-mask {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 100;
}

.confirm-dialog {
    position: fixed;
    left: 60rpx;
    top: 50%;
    transform: translateY(-50%);
    width: 630rpx;
    background: #ffffff;
    border-radius: 20rpx;
    padding: 40rpx 36rpx 28rpx;
    z-index: 101;
    box-sizing: border-box;
}

.confirm-title {
    font-size: 32rpx;
    font-weight: 600;
    text-align: center;
}

.confirm-content {
    margin-top: 24rpx;
    font-size: 26rpx;
    color: #646a73;
    line-height: 1.6;
    text-align: center;
}

.confirm-actions {
    display: flex;
    margin-top: 36rpx;
    gap: 20rpx;
}

.confirm-btn {
    flex: 1;
    height: 80rpx;
    line-height: 80rpx;
    text-align: center;
    border-radius: 12rpx;
    font-size: 28rpx;
}

.confirm-cancel {
    background: #f5f7fa;
    color: #646a73;
}

.confirm-ok {
    background: #1769e0;
    color: #ffffff;
}

page {
    min-height: 100%;
    background: #f5f7fa;
    color: #1f2329;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button {
    border-radius: 12rpx;
}

/* 通用卡片 */
.card {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 28rpx;
    box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

/* 通用主按钮 */
.btn-primary {
    background: #1769e0;
    color: #ffffff;
    font-size: 30rpx;
    border: none;
}

.btn-primary::after {
    border: none;
}

/* 标签 chip */
.tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 6rpx 18rpx;
    border-radius: 999rpx;
    font-size: 22rpx;
    line-height: 1.4;
    color: #ffffff;
}

/* 空态 */
.empty-view {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80rpx 40rpx;
    color: #8a9099;
}

.empty-view .empty-icon {
    font-size: 72rpx;
    margin-bottom: 20rpx;
}

.empty-view .empty-text {
    font-size: 28rpx;
}
